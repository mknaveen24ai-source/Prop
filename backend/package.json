{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server.js",
    "engines": {
        "node": "24.19.0"
    },
    "scripts": {
        "build:clean": "tsx scripts/build-support.ts clean dist",
        "build": "npm run build:clean && tsc -p tsconfig.build.json && tsx scripts/build-support.ts copy dist",
        "build:test": "tsx scripts/build-support.ts clean .test-dist && tsc -p tsconfig.test.json && tsx scripts/build-support.ts copy .test-dist",
        "typecheck": "tsc -p tsconfig.json",
        "start": "node dist/scripts/verify-runtime-version.js && node --enable-source-maps dist/server.js",
        "dev": "tsx watch server.js",
        "test:source": "node --test test/*.test.js",
        "test:compiled": "npm run build:test && BACKEND_SOURCE_ROOT=. node --enable-source-maps --test .test-dist/test/*.test.js",
        "test": "npm run test:compiled",
        "smoke:compiled": "node --check dist/server.js && node --check dist/workers/emailWorker.js && NODE_ENV=test node --enable-source-maps dist/scripts/compiled-smoke-target.js",
        "check:js-inventory": "node --enable-source-maps dist/scripts/check-js-inventory.js",
    "check:legacy": "node --check server.js && node --check dist/challengeEngine.js && node dist/scripts/verify-admin-bindings.js && node scripts/verify-tracked-requires.js && node scripts/check-param-type-collisions.js",
        "check:modules": "node --enable-source-maps dist/scripts/check-module-boundaries.js",
        "check": "npm run typecheck && npm run check:contracts && npm run build && npm run smoke:compiled && npm run check:js-inventory && npm run check:modules && npm run check:legacy",
        "check:contracts": "tsx scripts/check-contracts-policy.ts",
        "lint": "eslint .",
        "lint:strict": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "deploy:preflight": "node --enable-source-maps dist/scripts/deploy-preflight.js",
        "security-audit": "node --enable-source-maps dist/scripts/security-audit.js",
        "admin:harden": "node --enable-source-maps dist/scripts/harden-admin-runtime.js",
        "email:verify": "node --enable-source-maps dist/scripts/verify-email-config.js",
        "email:worker": "node dist/scripts/verify-runtime-version.js && node --enable-source-maps dist/workers/emailWorker.js",
        "launch:smoke": "node --enable-source-maps dist/scripts/launch-smoke.js",
        "loadtest": "node --enable-source-maps dist/scripts/seed-load-test.js",
        "loadtest:sockets": "node --enable-source-maps dist/scripts/socket-load-test.js",
        "engine:equivalence": "node --enable-source-maps dist/scripts/engine-equivalence.js",
        "schema:dump": "node --enable-source-maps dist/scripts/dump-core-schema.js",
        "schema:verify": "node --enable-source-maps dist/scripts/verify-schema.js",
        "check:sql-columns": "node --enable-source-maps dist/scripts/check-sql-columns.js",
        "check:sql-prepare": "node --enable-source-maps dist/scripts/audit/sql-prepare-check.js",
        "audit:authz": "node --enable-source-maps dist/scripts/audit/authz-matrix.js",
        "audit:money": "node --enable-source-maps dist/scripts/audit/money-integrity.js",
        "audit:races": "node --enable-source-maps dist/scripts/audit/race-conditions.js",
        "audit:routes": "node --enable-source-maps dist/scripts/audit/route-inventory.js",
        "fx:cutover-check": "node --enable-source-maps dist/scripts/verify-fx-cutover.js",
        "db:provision": "node dist/scripts/verify-runtime-version.js && node --enable-source-maps dist/scripts/provision-db.js",
        "migrate": "knex --knexfile dist/knexfile.js migrate:latest",
        "migrate:make": "knex migrate:make",
        "migrate:rollback": "knex --knexfile dist/knexfile.js migrate:rollback",
        "migrate:status": "knex --knexfile dist/knexfile.js migrate:status",
        "migrate:list": "node --enable-source-maps dist/scripts/list-migrations.js",
        "schema:baseline": "node --enable-source-maps dist/scripts/baseline-schema.js",
        "certificates:verify": "node --enable-source-maps dist/scripts/certificates/run-all.js",
        "certificates:render": "node --enable-source-maps dist/scripts/certificates/render-fixture.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@propfirm/contracts": "file:../contracts",
        "@resvg/resvg-js": "2.6.2",
        "@sentry/node": "10.68.0",
        "@socket.io/redis-adapter": "8.3.0",
        "axios": "1.19.0",
        "bcryptjs": "3.0.3",
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "decimal.js": "10.6.0",
        "dotenv": "17.3.1",
        "express": "5.2.1",
        "express-rate-limit": "8.6.2",
        "helmet": "8.3.0",
        "jsonwebtoken": "9.0.3",
        "kafkajs": "2.2.4",
        "knex": "3.2.9",
        "multer": "2.2.0",
        "nodemailer": "9.0.4",
        "pdfkit": "0.19.1",
        "pg": "8.22.0",
        "prom-client": "15.1.3",
        "qrcode": "1.5.4",
        "rate-limit-redis": "6.0.1",
        "redis": "5.11.0",
        "socket.io": "4.8.3",
        "speakeasy": "2.0.0",
        "swagger-ui-express": "5.0.1",
        "uuid": "13.0.2",
        "winston": "3.19.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.0.0",
        "@types/node": "24.13.3",
        "@types/pg": "8.23.1",
        "@types/speakeasy": "2.0.10",
        "eslint": "10.8.1",
        "glob": "13.0.6",
        "globals": "17.11.0",
        "jiti": "2.7.0",
        "nodemon": "3.1.14",
        "socket.io-client": "4.8.3",
        "supertest": "7.2.2",
        "tsx": "4.23.12",
        "typescript": "5.9.3",
        "typescript-eslint": "8.68.0"
    }
}
