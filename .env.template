# ─────────────────────────────────────────────────────────────────────────────
# PropFirm Platform — Environment Template
# Copy this file to .env and fill in ALL values before running
# NEVER commit the real .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# For Docker: use the service name "postgres" as host
DB_NAME=propfirm
DB_USER=propfirm
DB_PASSWORD=__GENERATE_STRONG_PASSWORD__
DATABASE_URL=postgresql://propfirm:__GENERATE_STRONG_PASSWORD__@postgres:5432/propfirm

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE_STRONG_PASSWORD__
REDIS_URL=redis://:__GENERATE_STRONG_PASSWORD__@redis:6379

# ── JWT Secrets — MUST be unique per client deployment ───────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=__GENERATE_64_CHAR_HEX__
JWT_EXPIRES_IN=24h
ADMIN_JWT_SECRET=__GENERATE_64_CHAR_HEX__

# ── TOTP 2FA Encryption Key ───────────────────────────────────────────────────
# 32-byte AES-256 key (64 hex chars)
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=__GENERATE_64_CHAR_HEX__

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=__GENERATE_STRONG_PASSWORD__

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.yourclientdomain.com

# ── Branding ─────────────────────────────────────────────────────────────────
PLATFORM_NAME=YourFirmName
BRAND_PRIMARY_COLOR=#0066ff
SUPPORT_EMAIL=support@yourclientdomain.com

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=__YOUR_SENDGRID_KEY__

# ── Market Data ──────────────────────────────────────────────────────────────
TWELVEDATA_API_KEY=__YOUR_TWELVEDATA_KEY__

# ── MT5 Integration (optional) ───────────────────────────────────────────────
DWX_PATH=/path/to/mt5/files/DWX

# ── Kafka (optional — leave blank to disable) ────────────────────────────────
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=propfirm
