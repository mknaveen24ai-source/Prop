# ═════════════════════════════════════════════════════════════════════════════
# PropFirm Platform — Docker Compose environment
#
#   cp .env.template .env    then fill in every value marked REQUIRED.
#
# This file is consumed by docker-compose.yml (both for ${...} interpolation in
# the compose file itself and via `env_file:` into the backend + email-worker
# containers). It is NOT the same as backend/.env.example, which documents the
# full set of optional backend knobs for local development.
#
# NEVER commit the resulting .env — it is gitignored.
#
# Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# backend/env.js rejects any secret shorter than 32 chars or matching
# /your-|changeme|change-me|example|placeholder|password|default/i, so do not
# hand-write these.
# ═════════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Behind the bundled nginx proxy there is exactly one hop. Leave as 1 unless you
# add another proxy (e.g. Cloudflare) in front, then increase to match.
TRUST_PROXY=1

# ── Trade engine ─────────────────────────────────────────────────────────────
# interval — the original polling engine: SL/TP and pending orders checked every
#            500ms, floating drawdown every 1s. Reaction time 500-1500ms.
# event    — the price tick drives SL/TP, pending fills, trailing drawdown,
#            daily loss and profit targets directly. Reaction time ~50-80ms, and
#            traders get live equity pushed to the dashboard. The polling loops
#            stay registered at a slow cadence as a safety net.
#
# Both modes make identical DECISIONS — verified by scripts/engine-equivalence.js,
# which replays one price walk through each path and diffs every table the engine
# writes. Every trade closure, breach, pass and pending fill matches exactly.
#
# ONE column differs, and it is not cosmetic. `accounts.eod_peak_equity` comes out
# HIGHER under `event` (observed +$10 to +$40 on the harness scenarios), because
# the event path evaluates on every tick while the interval path samples once a
# second and misses intermediate highs. The event number is the truer high-water
# mark — but eod_peak_equity feeds the trailing drawdown floor, so a higher peak
# means a HIGHER FLOOR and traders breach marginally earlier than they do today.
#
# That fairness decision was taken deliberately on 2026-08-17: `event` is the
# default. The gap is ~0.2% of a 10% drawdown allowance, and the event figure is
# the peak the trailing-drawdown rule actually describes — the interval path was
# under-measuring it. Re-run the harness after any engine change:
#
#     node scripts/engine-equivalence.js --ticks=80
#
# Roll back by setting this to `interval` and restarting — no migration needs
# reverting.
ENGINE_MODE=event

# ── FX conversion (audit finding C-01) ───────────────────────────────────────
# calculatePnL() computes priceDiff * lots * contractSize and books the result
# as USD. That product is denominated in the instrument's QUOTE currency, so it
# is only correct where the quote currency IS USD. It is wrong by the QUOTE/USD
# rate for 31 of the 45 instruments — roughly 150x on the JPY pairs and JP225.
#
# While this is `false`, only the 14 USD-quoted instruments may be OPENED:
#   EURUSD GBPUSD AUDUSD NZDUSD XAUUSD XAGUSD XPTUSD XPDUSD
#   XTIUSD XBRUSD XNGUSD US30 USTEC US500
# The price feed still subscribes to all 45, so positions already open on a
# restricted instrument keep pricing, charting and closing normally — and the
# USDJPY/USDCHF/USDCAD quotes stay available as FX rate sources.
#
# Do NOT set this to true until backend/utils/fxRates.js is in place and the
# per-currency parity tests pass. Keep the frontend's
# VITE_FX_CONVERSION_ENABLED in step with this value.
FX_CONVERSION_ENABLED=false

# HKD is pegged to USD in the 7.75–7.85 band and there is no USDHKD pair in the
# feed, so HK50's conversion rate is configured rather than derived. Only read
# once FX_CONVERSION_ENABLED=true.
HKD_USD_PEGGED_RATE=7.80

# Backend connection pool size. See the sizing note in backend/db.js; postgres
# max_connections must stay comfortably above this (docker-compose sets 200).
DB_POOL_MAX=60

# ── Postgres ─────────────────────────────────────────────────────────────────
DB_NAME=propfirm
DB_USER=propfirm
DB_PASSWORD=                      # REQUIRED — 32+ random chars

# DATABASE_URL is deliberately NOT set here. docker-compose.yml assembles it
# from the three values above and injects it into the backend, migrate, and
# email-worker services, so setting it here would be ignored for those and
# could silently disagree with them.
#
# Uncomment ONLY if you are running the backend outside Docker Compose
# (env.js lists DATABASE_URL as required in production):
# DATABASE_URL=postgresql://propfirm:password@localhost:5432/propfirm

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                   # REQUIRED — 32+ random chars

# ── Public URLs ──────────────────────────────────────────────────────────────
# FRONTEND_URL drives the CORS allowlist (utils/allowedOrigins.js) and the links
# in outbound email. Must be the exact public origin, scheme included.
# NOTE: there is no CORS_ORIGINS variable — older docs were wrong. Use
# FRONTEND_URL, plus ALLOWED_ORIGINS for any additional comma-separated hosts.
FRONTEND_URL=https://your-domain.com    # REQUIRED
PUBLIC_API_URL=https://your-domain.com
ALLOWED_ORIGINS=

# Leave EMPTY. VITE_API_URL is the frontend's axios baseURL and every call path
# already begins with /api/... — behind the same-origin nginx proxy, empty is
# correct. A value here produces /api/api/... and breaks every request.
VITE_API_URL=

# ── Secrets (all REQUIRED in production — startup aborts without them) ───────
JWT_SECRET=                       # REQUIRED — 32+ random hex
ADMIN_JWT_SECRET=                 # REQUIRED — 32+ random hex, different from above
ADMIN_PASSWORD=                   # REQUIRED — 32+ random chars, bootstrap only
KYC_FILE_ENCRYPTION_KEY=          # REQUIRED — 32+ random hex, encrypts KYC at rest

# Signs certificate integrity hashes. The public verification page recomputes
# the HMAC from the stored row, so rotating this invalidates the signature on
# every certificate already issued. Generate with: openssl rand -hex 32
CERTIFICATE_SIGNING_SECRET=__REPLACE_WITH_RANDOM_HEX__
TOTP_ENCRYPTION_KEY=              # 32+ hex chars, encrypts admin/user TOTP seeds

# Token lifetimes, in seconds
JWT_EXPIRES_IN=604800             # 7 days
ADMIN_JWT_EXPIRES_IN=28800        # 8 hours

# ── Email (REQUIRED for password reset, KYC, and payout notifications) ───────
# SMTP_FROM must be a verified sender on your own domain. env.js flags it as
# unsafe if it equals SMTP_USER or uses an ESP technical domain
# (sendgrid.net, smtp-brevo.com, mailgun.org, amazonses.com, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@your-domain.com

EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10

# ── Price feed (MetaTrader 5 / DWX bridge) ──────────────────────────────────
# The feed is FILE-BASED ONLY — there is no HTTP/WebSocket market data source.
# An MT5 terminal must run outside these containers (Windows host or Wine) and
# write its DWX files into the host directory named below, which is bind-mounted
# READ-WRITE into the backend container at /app/mt5-bridge. Read-write is not
# optional: the backend writes DWX_Commands_0.txt there to subscribe to symbols.
#
# The directory must be writable by uid 1001, the user the backend container
# runs as. Docker creates a missing bind-mount source owned by root, so symbol
# subscription then fails with EACCES and it looks like "no prices" rather than
# a permission problem. deploy.sh creates and chowns it for you.
#
# See DEPLOYMENT_CHECKLIST.md → "Price feed" for the full explanation.
MT5_BRIDGE_PATH=/opt/propfirm/mt5-bridge
DWX_PATH=/app/mt5-bridge

# Set to true ONLY on a staging box that runs NODE_ENV=production deliberately
# and wants the synthetic feed (docker compose --profile demo). It lets
# scripts/fake-dwx-feed.js run under NODE_ENV=production, where it otherwise
# refuses — synthetic random walks pricing real trades is the one accident that
# must never happen by default. Leave unset in production.
# ALLOW_DEMO_FEED=false

# ── Price history retention (days) ──────────────────────────────────────────
PRICE_HISTORY_RETAIN_DAYS=30
PRICE_HISTORY_1H_RETAIN_DAYS=365

# ── Branding (served to the SPA at runtime by BrandingContext) ──────────────
PLATFORM_NAME=PropFirm
FIRM_NAME=PropFirm
BRAND_PRIMARY_COLOR=#0066ff
SUPPORT_EMAIL=support@your-domain.com

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability (optional but strongly recommended) ───────────────────────
SENTRY_DSN=                       # backend
FRONTEND_SENTRY_DSN=              # baked into the SPA bundle at build time
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# ── Optional integrations ───────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Horizontal scaling (audit finding H-08) ──────────────────────────────────
# Socket.IO rooms are per-process unless a Redis adapter is attached. Without
# one, a second backend instance silently drops roughly half of all realtime
# events (SL/TP fills, account_failed, payout_approved) — nothing errors,
# traders just stop seeing their own fills.
#
# The adapter attaches automatically when REDIS_URL is reachable; there is no
# separate flag. Rate limiting shares the same client and behaves the same way:
# Redis up means counters are shared across instances, Redis down means they are
# per-process and reset on restart.
#
# One caveat that is NOT solved by Redis: the trade engine holds an in-memory
# trade index, so exactly one instance may run the engine. Scale the API tier
# freely; keep the engine single.

# ── Socket.IO transports ─────────────────────────────────────────────────────
# Comma-separated, in preference order. Defaults to `websocket,polling`.
#
# Long-polling is the fallback for networks that block WebSocket upgrades, so it
# is ON by default — dropping it cuts those traders off with no visible error.
# It is also the reason the socket upstream needs sticky routing
# (deploy/nginx/propfirm.scaleout.conf), and it costs roughly one HTTP request
# per client per broadcast window.
#
# Set to `websocket` once you know your clients can reach you over WebSocket —
# at 10K concurrent sockets that is a large saving and it removes the stickiness
# requirement. Verify with scripts/socket-load-test.js before committing to it.
# SOCKET_TRANSPORTS=websocket

# ── Realtime fan-out cadence ─────────────────────────────────────────────────
# Ceilings on how often browsers are sent data. The ENGINE is unaffected by both:
# stop-losses are evaluated on every tick regardless, so lowering these buys
# perceived smoothness, not faster execution.
#
# ── Lowering PRICE_BROADCAST_MS is far cheaper than it looks ──
#
# The intuition is that halving the interval doubles the cost. It does not,
# because these are DELTAS: a frame carries the instruments that moved, so total
# bytes track the rate of price CHANGES, not the broadcast rate. A shorter window
# just packages the same changes into more, smaller frames.
#
# Measured with scripts/socket-load-test.js — 300 sockets, 10Hz synthetic feed,
# 3 instruments moving per tick, one machine:
#
#              frames/s     server->clients   per socket   latency p95
#   250ms        1,174          0.98 MB/s      3.34 KB/s      19 ms
#   100ms        2,825          1.06 MB/s      3.62 KB/s      16 ms
#
# So 100ms costs ~8% more bandwidth, not 150% — but 2.4x the frames, and frames
# are socket writes. Bandwidth is not the constraint; per-socket write volume is.
#
# Re-measure on your own gateway spec before committing: a feed that moves more
# instruments per tick coalesces more at 250ms and shifts the ratio, and 300
# sockets on one box is not 3,300 on a gateway.
# PRICE_BROADCAST_MS=250

# Not covered by the run above — the load harness seeds users but no accounts or
# trades, so no equity frames are produced. Measure this one against a populated
# database before changing it.
# EQUITY_PUSH_INTERVAL_MS=500
