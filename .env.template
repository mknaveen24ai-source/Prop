# ═════════════════════════════════════════════════════════════════════════════
# PropFirm Platform — Docker Compose environment
#
#   cp .env.template .env    then fill in every value marked REQUIRED.
#
# This file is consumed by docker-compose.yml (both for ${...} interpolation in
# the compose file itself and via `env_file:` into the backend + email-worker
# containers). It is NOT the same as backend/.env.example, which documents the
# full set of optional backend knobs for local development.
#
# NEVER commit the resulting .env — it is gitignored.
#
# Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# backend/env.js rejects any secret shorter than 32 chars or matching
# /your-|changeme|change-me|example|placeholder|password|default/i, so do not
# hand-write these.
# ═════════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Behind the bundled nginx proxy there is exactly one hop. Leave as 1 unless you
# add another proxy (e.g. Cloudflare) in front, then increase to match.
TRUST_PROXY=1

# ── Postgres ─────────────────────────────────────────────────────────────────
DB_NAME=propfirm
DB_USER=propfirm
DB_PASSWORD=                      # REQUIRED — 32+ random chars

# DATABASE_URL is deliberately NOT set here. docker-compose.yml assembles it
# from the three values above and injects it into the backend, migrate, and
# email-worker services, so setting it here would be ignored for those and
# could silently disagree with them.
#
# Uncomment ONLY if you are running the backend outside Docker Compose
# (env.js lists DATABASE_URL as required in production):
# DATABASE_URL=postgresql://propfirm:password@localhost:5432/propfirm

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                   # REQUIRED — 32+ random chars

# ── Public URLs ──────────────────────────────────────────────────────────────
# FRONTEND_URL drives the CORS allowlist (utils/allowedOrigins.js) and the links
# in outbound email. Must be the exact public origin, scheme included.
# NOTE: there is no CORS_ORIGINS variable — older docs were wrong. Use
# FRONTEND_URL, plus ALLOWED_ORIGINS for any additional comma-separated hosts.
FRONTEND_URL=https://your-domain.com    # REQUIRED
PUBLIC_API_URL=https://your-domain.com
ALLOWED_ORIGINS=

# Leave EMPTY. VITE_API_URL is the frontend's axios baseURL and every call path
# already begins with /api/... — behind the same-origin nginx proxy, empty is
# correct. A value here produces /api/api/... and breaks every request.
VITE_API_URL=

# ── Secrets (all REQUIRED in production — startup aborts without them) ───────
JWT_SECRET=                       # REQUIRED — 32+ random hex
ADMIN_JWT_SECRET=                 # REQUIRED — 32+ random hex, different from above
ADMIN_PASSWORD=                   # REQUIRED — 32+ random chars, bootstrap only
KYC_FILE_ENCRYPTION_KEY=          # REQUIRED — 32+ random hex, encrypts KYC at rest
TOTP_ENCRYPTION_KEY=              # 32+ hex chars, encrypts admin/user TOTP seeds

# Token lifetimes, in seconds
JWT_EXPIRES_IN=604800             # 7 days
ADMIN_JWT_EXPIRES_IN=28800        # 8 hours

# ── Email (REQUIRED for password reset, KYC, and payout notifications) ───────
# SMTP_FROM must be a verified sender on your own domain. env.js flags it as
# unsafe if it equals SMTP_USER or uses an ESP technical domain
# (sendgrid.net, smtp-brevo.com, mailgun.org, amazonses.com, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@your-domain.com

EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10

# ── Price feed (MetaTrader 5 / DWX bridge) ──────────────────────────────────
# The feed is FILE-BASED ONLY — there is no HTTP/WebSocket market data source.
# An MT5 terminal must run outside these containers (Windows host or Wine) and
# write its DWX files into the host directory named below, which is bind-mounted
# read-only into the backend container at /app/mt5-bridge.
# See DEPLOYMENT_CHECKLIST.md → "Price feed" for the full explanation.
MT5_BRIDGE_PATH=/opt/propfirm/mt5-bridge
DWX_PATH=/app/mt5-bridge

# ── Price history retention (days) ──────────────────────────────────────────
PRICE_HISTORY_RETAIN_DAYS=30
PRICE_HISTORY_1H_RETAIN_DAYS=365

# ── Branding (served to the SPA at runtime by BrandingContext) ──────────────
PLATFORM_NAME=PropFirm
FIRM_NAME=PropFirm
BRAND_PRIMARY_COLOR=#0066ff
SUPPORT_EMAIL=support@your-domain.com

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability (optional but strongly recommended) ───────────────────────
SENTRY_DSN=                       # backend
FRONTEND_SENTRY_DSN=              # baked into the SPA bundle at build time
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# ── Optional integrations ───────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
