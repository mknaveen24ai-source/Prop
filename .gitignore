.cursor/
.orchids/
.qwen/
node_modules/

# Secrets — never commit
.env
.env.local
.env.*.local
backend/.env
frontend/.env
# Accidentally committed once as "env" (missing the leading dot) with real
# secrets in it (commit a7f610c) — Node's require('./env') also shadows
# backend/env.js with this file if it exists, so it must never come back.
backend/env
# Same incident, second file: committed as "front env" in 9e236b3. The rule
# above does not cover it because of the space.
backend/front env

# TLS private keys / certs (deploy/certs/.gitkeep documents how to issue them)
deploy/certs/*.pem
deploy/certs/*.key
deploy/certs/*.crt

# Incident runbook: names which secrets leaked and in which commits, i.e. an
# attack map. Keep it local until rotation is complete.
SECRET_ROTATION_RUNBOOK.md

# Stray artifacts
backend/image.png
# Runtime files the MT5 bridge reads/writes in place; they are inputs to a
# running deployment, never source.
deploy/mt5-bridge/DWX_*.txt

# Build output / runtime artifacts
frontend/build/
frontend/dist/
logs/
backend/logs/
backend/uploads/
backend/dist/
backend/.test-dist/
*.tsbuildinfo
backups/
e2e/playwright-report/
e2e/test-results/

# NOTE (audit L-07): ALL_*.md no longer matches anything tracked --
# ALL_BUGS_AND_ISSUES.md predates this rule and is committed. Left in place so
# new scratch reports stay ignored; the superseded April snapshots
# (ALL_BUGS_AND_ISSUES.md, CODE_QUALITY_ASSESSMENT.md) are the user's call to
# remove, not a safe automatic deletion.
ALL_*.md
BUG_ANALYSIS_REPORT.md
CHAT_FEATURE_DOCUMENTATION.md
CHAT_FIXES.md
FEATURE_IDEAS.md
FINAL_FIX_SUMMARY.md
FINAL_STATUS.md
FIXES_APPLIED.md
PRICE_FEED_FIX.md
PROJECT_HANDOFF.md
PROJECT_IMPROVEMENTS.md
REMAINING_FIXES.md
SECURITY_FIXES_SUMMARY.md
UUID_CHAT_FIX.md

fix_encoding.js
patch*.js
patch*.py
test_news.js

# Smoke-test scratch directory (launch-smoke.js writes process logs + EA here)
backend/tmp-smoke/
